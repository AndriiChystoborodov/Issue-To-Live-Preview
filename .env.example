# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Slack Bot Token (starts with xoxb-)
# Get it from: Slack App Dashboard → OAuth & Permissions
SLACK_BOT_TOKEN=

# Slack App-Level Token (starts with xapp-)
# Get it from: Slack App Dashboard → Basic Information → App-Level Tokens
# Requires scope: connections:write
SLACK_APP_TOKEN=
